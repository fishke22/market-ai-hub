# MARKET_AI_HUB secrets template — 複製成 .env 再填，不要 commit .env

# FinMind API token (免費申請: https://finmindtrade.com)
FINMIND_TOKEN=

# FRED API key (免費申請: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Hugging Face token — 公開模型(chronos-2 / timesfm-3)不需要，保持空白即可
HF_TOKEN=

# BEA API key（GDP/PCE，免費申請：https://apps.bea.gov/API/signup/）
BEA_API_KEY=

# Japan e-Stat appId（日本官方統計：https://www.e-stat.go.jp/api/）
ESTAT_APP_ID=

# EIA API key（能源/WTI：https://www.eia.gov/opendata/）
EIA_API_KEY=

# EDINET API key（日本有價證券報告書，config-only 直到有 key）
EDINET_API_KEY=
